{
  "name": "foxscan",
  "main": "cloudflare/src/index.js",
  "account_id": "8484a6c691b273507d672befadbf2305",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
